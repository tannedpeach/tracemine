-            return jsonify(error="not found"), 404
-        data = request.get_json(silent=True) or {}
-        if "title" in data:
-            issue["title"] = data["title"]
-        if "status" in data:
-            issue["status"] = data["status"]
-        return jsonify(issue)
+        with lock:
+            issue = issues.get(issue_id)
+            if issue is None:
+                return jsonify(error="not found"), 404
+            data = request.get_json(silent=True) or {}
+            if "title" in data:
+                issue["title"] = data["title"]
+            if "status" in data:
